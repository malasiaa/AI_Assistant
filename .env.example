# Copy this file to .env and fill in your own values. Never commit .env.

# Required: LLM access through OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional: comma-separated origins allowed to call the API (default: Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
